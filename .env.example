# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).

# --- Database ---
# PostgreSQL (local dev via Homebrew postgresql@16: `brew services start postgresql@16`,
# then `createdb viewnear_dev`). Schema is managed with Prisma Migrate.
DATABASE_URL="postgresql://USER@localhost:5432/viewnear_dev?schema=public"

# --- Auth (NextAuth) ---
# REQUIRED in production. Generate a strong value: openssl rand -base64 32
# The app refuses to boot in production if this is left as a dev/default value.
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Seeded admin user ---
# Used only by `prisma db seed`. CHANGE THE PASSWORD before seeding any shared
# or production database, then log in and rotate it.
SEED_ADMIN_EMAIL="admin@viewnear.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Viewnear Admin"

# --- Media storage ---
# local = filesystem (./public/uploads, dev only — ephemeral on serverless).
# s3 = S3-compatible (AWS S3, Cloudflare R2, etc.) — required for production.
STORAGE_DRIVER="local"
# Required when STORAGE_DRIVER="s3":
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint (e.g. Cloudflare R2) and public base URL for objects.
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# --- Email notifications (optional; no-ops if unset) ---
RESEND_API_KEY=""
NOTIFY_TO="contact@viewnear.com"

# --- Analytics (optional; loads only after cookie consent) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=""
