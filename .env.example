# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).

# --- Database ---
# PostgreSQL (local dev via Homebrew postgresql@16: `brew services start postgresql@16`,
# then `createdb viewnear_dev`). The build runs `prisma db push` to sync the schema.
# DATABASE_URL: pooled connection used at runtime (e.g. Neon -pooler endpoint in prod).
# DIRECT_DATABASE_URL: direct, non-pooled connection used for schema ops (db push);
#   locally it mirrors DATABASE_URL, in prod it's the non-pooler endpoint.
DATABASE_URL="postgresql://USER@localhost:5432/viewnear_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://USER@localhost:5432/viewnear_dev?schema=public"

# --- Admin surface ---
# The CMS (/admin, its APIs, and the auth endpoints) only exists in local dev.
# Deployed environments serve a 404 for all of it unless this is explicitly
# set to "true" (middleware.ts).
# ADMIN_ENABLED="true"

# --- Auth (NextAuth) ---
# REQUIRED in production. Generate a strong value: openssl rand -base64 32
# The app refuses to boot in production if this is left as a dev/default value.
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Seeded admin user ---
# Used only by `prisma db seed`. CHANGE THE PASSWORD before seeding any shared
# or production database, then log in and rotate it.
SEED_ADMIN_EMAIL="admin@viewnear.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Viewnear Admin"

# --- Media storage ---
# local = filesystem (./public/uploads). Fine for local dev; on Render/serverless
#   the disk is EPHEMERAL — uploads vanish on every deploy. Use s3 in production.
# s3 = S3-compatible object storage (Cloudflare R2, AWS S3, …) — required for prod.
STORAGE_DRIVER="local"
#
# Required when STORAGE_DRIVER="s3":
S3_BUCKET=""                 # bucket name, e.g. viewnear-media
S3_PRIVATE_BUCKET=""         # separate bucket for applicant resumes (PII). Public
                             #   access DISABLED; objects are served only via the
                             #   authenticated admin API, never a public URL.
                             #   Required in production when STORAGE_DRIVER="s3".
S3_ACCESS_KEY_ID=""          # R2: API token Access Key ID
S3_SECRET_ACCESS_KEY=""      # R2: API token Secret Access Key
# Cloudflare R2 specifics:
S3_REGION="auto"             # R2 ignores region; "auto" is correct
S3_ENDPOINT=""               # R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_URL=""             # Public base URL for objects (NO trailing slash):
                             #   r2.dev dev URL  -> https://pub-<hash>.r2.dev
                             #   or custom domain -> https://cdn.viewnear.com
                             # Must also be set at BUILD time (next.config reads it
                             # to allow next/image to load from this host).
NEXT_PUBLIC_S3_PUBLIC_URL="" # Same value as S3_PUBLIC_URL, exposed to the client
                             # bundle so next/image (client-side) knows which
                             # remote host is safe to request through /_next/image
                             # instead of falling back to unoptimized.

# --- Email notifications (optional; no-ops if unset) ---
RESEND_API_KEY=""
NOTIFY_TO="contact@viewnear.com"

# --- Analytics (optional; loads only after cookie consent) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=""

# --- Search-engine verification (optional; emits a verification meta tag) ---
# Prove domain ownership so you can see impressions, positions, and indexing
# coverage. When set, app/[locale]/layout.tsx emits the matching <meta> tag;
# when blank, no tag is emitted. Set these in the PRODUCTION environment
# (Render), not just locally, then verify the property against viewnear.com.
#
# GOOGLE_SITE_VERIFICATION: Google Search Console -> add a "URL prefix"
#   property for https://www.viewnear.com -> choose the "HTML tag" method ->
#   copy ONLY the content="..." token (not the whole tag) here. After it
#   deploys, click Verify, then submit https://www.viewnear.com/sitemap.xml
#   under Sitemaps, and use URL Inspection to request indexing of the key pages.
GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION: Bing Webmaster Tools -> add site -> "Add a meta tag"
#   -> copy the content token here (emitted as <meta name="msvalidate.01">).
#   Bing can also import the property directly from Google Search Console.
BING_SITE_VERIFICATION=""

# --- Site chat agent ("Nova"), /api/chat (required for the chat widget to answer) ---
# console.anthropic.com -> Settings -> API Keys. Without this the widget still
# renders but replies with "Chat is not configured yet." (503), so it's safe
# to deploy before this is set.
ANTHROPIC_API_KEY=""
