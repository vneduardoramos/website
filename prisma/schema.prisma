// ViewNear CMS data model.
//
// Runs on PostgreSQL. For historical reasons (this model was first authored on
// SQLite, which lacks native enums, scalar lists, and Json), some fields use
// portable representations rather than Postgres-native types:
//   - status/role/kind fields are String (validated in app code via lib/enums.ts)
//   - list fields (tools, skills) and structured blobs are stored as JSON-encoded
//     String and parsed in app code via lib/utils.ts (asStringArray / asObjectArray)
// These can optionally be promoted to real enums / Json / scalar lists later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the pooled connection (url). Schema operations
  // (prisma db push during the build) use a direct, non-pooled connection
  // (directUrl), since pooled endpoints don't support the locks they need.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         String     @default("EDITOR") // ADMIN | EDITOR
  posts        BlogPost[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TeamMember {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  title         String
  bio           String?
  photo         String? // path to a headshot image in /public
  headshotId    String?
  headshot      Media?     @relation(fields: [headshotId], references: [id])
  bookingUrl    String?
  linkedinUrl   String?
  authoredPosts BlogPost[] @relation("BlogAuthor")
  // --- Spanish (es) ---
  titleEs       String?
  bioEs         String?
  order         Int        @default(0)
  published     Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Client {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  sector      String?
  region      String?
  logoColor   String? // path to placeholder logo asset
  caseStudies CaseStudy[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Service {
  id               String    @id @default(cuid())
  slug             String    @unique
  tier             String // THINK | BUILD | GROW
  title            String
  summary          String
  body             String?
  tools            String? // string[]
  icon             String?
  order            Int       @default(0)
  // --- Spanish (es) ---
  titleEs          String?
  summaryEs        String?
  bodyEs           String?
  seoTitleEs       String?
  seoDescriptionEs String?
  status           String    @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Industry {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  headline         String
  intro            String
  challenges       String? // [{problem, response}]
  deliverables     String? // [{title, description}]
  tools            String? // string[]
  stats            String? // [{label, value}]
  body             String?
  ogImage          String?
  caseStudies      CaseStudy[]
  // --- Spanish (es) ---
  nameEs           String?
  headlineEs       String?
  introEs          String?
  challengesEs     String?
  deliverablesEs   String?
  statsEs          String?
  bodyEs           String?
  seoTitleEs       String?
  seoDescriptionEs String?
  status           String      @default("PUBLISHED")
  publishedAt      DateTime?
  order            Int         @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model CaseStudy {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  summary          String
  body             String?
  sector           String
  region           String
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id])
  industryId       String?
  industry         Industry? @relation(fields: [industryId], references: [id])
  heroImage        String?
  metrics          String? // JSON [{value,label}]
  quote            String? // JSON {text,author,role}
  challenge        String?
  solution         String?
  results          String?
  featured         Boolean   @default(false)
  // --- Spanish (es) ---
  titleEs          String?
  summaryEs        String?
  bodyEs           String?
  metricsEs        String?
  quoteEs          String?
  challengeEs      String?
  solutionEs       String?
  resultsEs        String?
  seoTitleEs       String?
  seoDescriptionEs String?
  status           String    @default("PUBLISHED")
  publishedAt      DateTime?
  order            Int       @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model BlogPost {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  excerpt          String?
  body             String
  keyTakeaways     String? // JSON string[]
  coverImageId     String?
  coverImage       Media?      @relation("BlogCover", fields: [coverImageId], references: [id])
  coverImageUrl    String?
  authorId         String?
  author           User?       @relation(fields: [authorId], references: [id])
  authorTeamId     String?
  authorTeam       TeamMember? @relation("BlogAuthor", fields: [authorTeamId], references: [id])
  tags             Tag[]       @relation("BlogPostTags")
  // --- Spanish (es) ---
  titleEs          String?
  excerptEs        String?
  bodyEs           String?
  keyTakeawaysEs   String?
  seoTitleEs       String?
  seoDescriptionEs String?
  status           String      @default("DRAFT")
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  ogImage          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model NewsEvent {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  kind           String    @default("announcement") // announcement | event | press
  excerpt        String?
  body           String
  keyTakeaways   String? // JSON string[]
  eventDate      DateTime?
  venue          String?
  agenda         String? // [{time, item}]
  readMinutes    Int?
  coverImage     String?
  externalUrl    String?
  status         String    @default("PUBLISHED")
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Tag {
  id     String     @id @default(cuid())
  slug   String     @unique
  name   String
  // --- Spanish (es) ---
  nameEs String?
  posts  BlogPost[] @relation("BlogPostTags")
}

model Media {
  id         String       @id @default(cuid())
  filename   String
  url        String
  mimeType   String
  width      Int?
  height     Int?
  alt        String?
  storageKey String
  createdAt  DateTime     @default(now())
  blogCovers BlogPost[]   @relation("BlogCover")
  headshots  TeamMember[]
}

model Lead {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  company   String?
  message   String
  source    String   @default("contact")
  status    String   @default("NEW") // NEW | CONTACTED | QUALIFIED | CLOSED
  createdAt DateTime @default(now())
}

model JobOpening {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  employment    String
  location      String?
  description   String // short summary (hero subtitle, listing card, SEO)
  body          String? // full role detail, Markdown (About the role / What you'll do / What we're looking for)
  skills        String? // string[]
  // --- Spanish (es) ---
  titleEs       String?
  descriptionEs String?
  bodyEs        String?
  employmentEs  String?
  status        String           @default("PUBLISHED")
  publishedAt   DateTime?
  order         Int              @default(0)
  applications  JobApplication[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model JobApplication {
  id          String      @id @default(cuid())
  openingId   String?
  opening     JobOpening? @relation(fields: [openingId], references: [id])
  name        String
  email       String
  message     String?
  linkedinUrl String?
  resumeUrl   String?
  createdAt   DateTime    @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON-encoded
  updatedAt DateTime @updatedAt
}

model ImageOverride {
  id        String   @id @default(cuid())
  key       String   @unique
  mediaUrl  String?
  focalX    Float    @default(50)
  focalY    Float    @default(50)
  zoom      Float    @default(1)
  alt       String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}
